<Window x:Class="GpuPvSetup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GpuPvSetup"
        mc:Ignorable="d"
        Title="GPU-PV Automator" Height="450" Width="600"
        Background="#1E1E1E" Foreground="White"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI">

    <!-- Efecto sombra para la ventana (opcional, si se usa WindowStyle="None" queda mejor, pero dejaremos el predeterminado de Windows) -->
    <Window.Resources>
        <!-- Estilo redondeado para el botón -->
        <Style TargetType="Button" x:Key="FluentButton">
            <Setter Property="Background" Value="#0078D4"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2B88D8"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#005A9E"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#333333"/>
                    <Setter Property="Foreground" Value="#888888"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Estilo del ComboBox -->
        <Style TargetType="ComboBox" x:Key="FluentComboBox">
            <Setter Property="Background" Value="#2D2D2D"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#444444"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="5"/>
        </Style>

    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Título -->
            <RowDefinition Height="Auto"/> <!-- Selección de VM -->
            <RowDefinition Height="Auto"/> <!-- Botón -->
            <RowDefinition Height="Auto"/> <!-- Progreso -->
            <RowDefinition Height="*"/>    <!-- Logs -->
        </Grid.RowDefinitions>

        <!-- Título -->
        <TextBlock Grid.Row="0" Text="Configuración de GPU-PV en Hyper-V"
                   FontSize="24" FontWeight="SemiBold" Margin="0,0,0,20"/>

        <!-- Selección de VM -->
        <StackPanel Grid.Row="1" Orientation="Vertical" Margin="0,0,0,20">
            <Label Target="{Binding ElementName=VmComboBox}" Content="Seleccione la Máquina Virtual:" FontSize="14" Margin="0,0,0,5" Foreground="#CCCCCC" Padding="0"/>
            <ComboBox x:Name="VmComboBox" AutomationProperties.Name="Máquina Virtual" ToolTip="Selecciona la máquina virtual para configurar GPU-PV" Style="{StaticResource FluentComboBox}" Height="35" FontSize="14" VerticalContentAlignment="Center"/>
            <Button x:Name="RefreshVmButton" AutomationProperties.Name="Refrescar lista" ToolTip="Actualiza la lista de máquinas virtuales" Content="🔄 Refrescar" Width="100" Height="30" Margin="0,10,0,0"
                    HorizontalAlignment="Left" Style="{StaticResource FluentButton}" Click="RefreshVmButton_Click"/>
        </StackPanel>

        <!-- Botón Principal -->
        <Button x:Name="ApplyButton" Grid.Row="2" Content="Aplicar GPU-PV"
                AutomationProperties.Name="Aplicar configuración" ToolTip="Inicia el proceso de configuración en la máquina seleccionada"
                Style="{StaticResource FluentButton}"
                Height="50" FontSize="18" FontWeight="Bold" Margin="0,0,0,20"
                Click="ApplyButton_Click"/>

        <!-- Barra de Progreso -->
        <StackPanel Grid.Row="3" Margin="0,0,0,20">
            <TextBlock x:Name="StatusTextBlock" Text="Listo." FontSize="14" Margin="0,0,0,5" Foreground="#AAAAAA"/>
            <ProgressBar x:Name="ActionProgressBar" AutomationProperties.Name="Progreso de la operación" ToolTip="Muestra el progreso de la tarea actual" Height="4" Background="#333333" Foreground="#0078D4" BorderThickness="0"/>
        </StackPanel>

        <!-- Logs -->
        <Border Grid.Row="4" Background="#252525" CornerRadius="8" Padding="10">
            <TextBox x:Name="LogTextBox" AutomationProperties.Name="Registro de actividad" ToolTip="Muestra el registro detallado de las operaciones" IsReadOnly="True" Background="Transparent" BorderThickness="0" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" Foreground="#00FF00"/>
        </Border>
    </Grid>
</Window>
